rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Menu dishes collection & documents
    match /menu_dishes_list/{dishId} {
      allow read: if true;
      allow write: if true;
    }

    // Shop Settings & Metadata
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Fallback match for any other document
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
